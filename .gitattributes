# 默认：Git 自己判断文本文件，入库统一为 LF
* text=auto

# 明确指定文本文件，强制 LF（跨平台安全）
*.c    text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.proto text eol=lf

# Windows 专用脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件别动
*.png  binary
*.jpg  binary
*.zip  binary
*.exe  binary
*.dll  binary
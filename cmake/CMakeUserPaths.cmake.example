# 本机依赖路径覆盖 —— 模板
#
# 用法：把本文件复制成同目录下的 CMakeUserPaths.cmake，按需去掉注释。
# 那个文件被 .gitignore 忽略，只属于当前这台机器，永远不会进版本库。
# CMakeLists.txt 会在引入 SDL3 之前自动加载它（存在才加载）。
#
# 写法用 CACHE 形式（`set(变量 值 CACHE 类型 "说明")`）：
# 首次配置由本文件定值，之后命令行上的 -D 仍然可以临时覆盖它。
# 如果写成普通的 set(变量 值)，它会盖住命令行 -D，做一次性覆盖时容易困惑。
#
# 例子 1：本机有本地 SDL3，固定用它，不联网也不查系统
#   set(INK_SDL3_SOURCE "local" CACHE STRING "SDL3 来源")
#   set(INK_SDL3_LOCAL_DIR "C:/libs/SDL3" CACHE PATH "本地 SDL3 目录")
#
# 例子 2：只允许用系统装的 SDL3；找不到就报错，不会偷偷联网拉源码
#   set(INK_SDL3_SOURCE "system" CACHE STRING "SDL3 来源")
#
# 例子 3：总是拉源码一起编译，并固定 tag
#   set(INK_SDL3_SOURCE "fetch" CACHE STRING "SDL3 来源")
#   set(INK_SDL3_GIT_TAG "release-3.4.2" CACHE STRING "SDL3 tag")
#
# 例子 4：SDL3 装在非标准前缀，让 find_package 也能看到（配合 system 使用）
#   list(APPEND CMAKE_PREFIX_PATH "/opt/sdl3")
#
# 改了本文件之后要重新配置一次才生效：
#   cmake --preset msys2-debug
